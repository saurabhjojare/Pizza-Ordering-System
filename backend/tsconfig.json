{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",

    "outDir": "./dist",
    "baseUrl": "./",

    "declaration": true,
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}